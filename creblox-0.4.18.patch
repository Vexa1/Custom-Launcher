diff -ruN '--exclude=target' '--exclude=dist' '--exclude=.git' pristine-0417/.cargo/config.toml patched-0418/.cargo/config.toml
--- pristine-0417/.cargo/config.toml	1970-01-01 00:00:00.000000000 +0000
+++ patched-0418/.cargo/config.toml	2026-11-26 05:22:46.745807759 +0000
@@ -0,0 +1,7 @@
+# Catalina is the oldest supported macOS. Pinning this here (instead of only in
+# scripts/build-macos-app.sh) means a plain `cargo build --release` - including
+# the dependency build scripts, which never see the shell's environment - cannot
+# silently produce a binary that requires macOS 11 or newer. An explicit
+# MACOSX_DEPLOYMENT_TARGET in the environment still wins.
+[env]
+MACOSX_DEPLOYMENT_TARGET = "10.15"
